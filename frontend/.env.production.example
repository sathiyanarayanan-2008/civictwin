# CivicTwin AI - Frontend Environment Variables
# Copy to .env or set in Vercel Project Settings

# Production API Endpoint (Point to your deployed Render or hosting URL)
VITE_API_BASE_URL=https://civictwin-backend.onrender.com/api/v1

# Production WebSocket Endpoint
VITE_WS_URL=wss://civictwin-backend.onrender.com/api/v1/ws

# Evaluation City Configuration
VITE_DEFAULT_CITY=Chennai
VITE_ENABLE_3D_TWIN=true
VITE_OFFLINE_DEMO_MODE=false
